---
# Base the format on a standard style, then override specific settings below
BasedOnStyle: LLVM

# Indentation settings
IndentWidth: 4
TabWidth: 4
UseTab: Never

# Line wrapping
ColumnLimit: 100

# Brace placement (e.g., attach to function/if or put on new line)
BreakBeforeBraces: Attach

# Pointer alignment (e.g., int* x vs int *x)
PointerAlignment: Left

# Sort includes automatically
SortIncludes: true
---
